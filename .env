# Dev proxy mode: leave NEXT_PUBLIC_API_URL empty so all requests go through
# the built-in Next.js reverse-proxy (src/app/api/[...path]/route.js),
# which forwards to REMOTE_API_ORIGIN server-side and rewrites Set-Cookie
# to be first-party for localhost — cookies persist correctly this way.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_HEADER=ecommerce

# Remote API target for the server-side proxy (no trailing slash).
# Change this to http://localhost:3000 if running a local backend.
REMOTE_API_ORIGIN=https://api.shayegandesign.com
